rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Signed in with a verified email that has an entry in allowedUsers (added in the console)
    function isAllowed() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/allowedUsers/$(request.auth.token.email.lower()));
    }

    function isOwner(userId) {
      return isAllowed() && request.auth.uid == userId;
    }

    // Each user may only check their own entry, so nobody can list who is allowed
    match /allowedUsers/{email} {
      allow read: if request.auth != null && request.auth.token.email.lower() == email;
      allow write: if false;
    }

    // Allowed users can only read and write their own medications and settings
    match /users/{userId}/medications/{medicationId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/settings/{settingsId} {
      allow read, write: if isOwner(userId);
    }

    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
