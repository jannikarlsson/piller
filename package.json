{
	"name": "piller-app",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "husky && svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "node scripts/vitest.js run",
		"test:watch": "node scripts/vitest.js",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"deploy": "npm run build && firebase deploy --only hosting",
		"deploy:rules": "firebase deploy --only firestore:rules"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.4.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@vite-pwa/sveltekit": "^2.0.4",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.1",
		"magicast": "^0.5.5",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.2.0",
		"svelte": "^5.59.1",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.73.0",
		"vite": "^8.0.12",
		"vitest": "^5.1.1"
	},
	"dependencies": {
		"firebase": "^12.13.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
